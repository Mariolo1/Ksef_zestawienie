# Skopiuj jako .env i uzupełnij:  cp .env.example .env && chmod 600 .env

# Hasło bazy PostgreSQL (dowolne, długie)
POSTGRES_PASSWORD=zmien_mnie

# Sekret sesji:  openssl rand -hex 32
SECRET_KEY=

# Klucz szyfrowania certyfikatów (Fernet):
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# UWAGA: zgubienie tego klucza = utrata dostępu do zapisanych certyfikatów
MASTER_KEY=

# Adres, pod którym otwierasz aplikację w przeglądarce
PUBLIC_URL=http://localhost:8080
# true dopiero przy HTTPS
COOKIE_SECURE=false

# Logowanie Google (opcjonalne - puste = przycisk ukryty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
